{
  "name": "chess-demo",
  "version": "0.3.0",
  "description": "国际象棋：网页版与 Windows 客户端",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.js",
  "author": "Winston112358",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/resources/**/*.test.js\"",
    "test:ui": "playwright test",
    "check": "npm test && npm run build && npm run test:ui",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:web": "npm run build && node scripts/package-web.js",
    "test:release": "playwright test --config playwright.release.config.js",
    "setup:stockfish": "node scripts/setup-stockfish.js",
    "check:stockfish": "node scripts/check-stockfish-resources.js",
    "test:engine-transports": "node --test \"tests/engine/**/*.test.js\" && playwright test --config playwright.engine.config.js"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "io.github.winston112358.chess",
    "productName": "Chess Demo",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/web/**/*", "src/desktop/**/*", "src/engine/**/*", "package.json"],
    "extraResources": [
      { "from": "vendor/stockfish/native", "to": "stockfish/native" },
      { "from": "vendor/stockfish/web", "to": "stockfish/web" },
      { "from": "vendor/stockfish/source", "to": "stockfish/source" },
      { "from": "vendor/stockfish/manifest.json", "to": "stockfish/manifest.json" }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "Chess-Demo-${version}-${arch}.${ext}"
    }
  }
}
